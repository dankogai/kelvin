// BigInt's powers and the rest (#511) against Python: b ** e, b.pow(e),
// pow(b, e, m) and b.pow(e, m), Python's, the result of m's sign, a
// negative e by the inverse; gcd, lcm, isqrt; products past 40 limbs by
// Karatsuba's; a and m are lent to pow (#510), and stay
let main():int32 {
    do { let a = BigInt("28772721935282948428"); let m = BigInt("827346491373196795580457010295513369300449525974345074205373"); let b = BigInt("-8238189578454333843")
        print(a ** 29, " ", a.pow(29), " ", pow(a, 29, m), " ", a.pow(29, m), " ")
        println(a.gcd(b), " ", a.lcm(b), " ", a.abs.isqrt(), " ", a * b == b * a)
    } while false
    do { let a = BigInt("1"); let m = BigInt("152"); let b = BigInt("-128572171277484839580430130839404157094279935982272773416200942733291369975617960219735958")
        print(a ** 40, " ", a.pow(40), " ", pow(a, 40, m), " ", a.pow(40, m), " ")
        println(a.gcd(b), " ", a.lcm(b), " ", a.abs.isqrt(), " ", a * b == b * a)
    } while false
    do { let a = BigInt("-225"); let m = BigInt("373607597258839136757891497585642340762292263158860392953363"); let b = BigInt("2028358316332957458686746121501691440768682328328495968180014707211321367169041520256683686")
        print(a ** 1, " ", a.pow(1), " ", pow(a, 1, m), " ", a.pow(1, m), " ")
        println(a.gcd(b), " ", a.lcm(b), " ", a.abs.isqrt(), " ", a * b == b * a)
    } while false
    do { let a = BigInt("-1"); let m = BigInt("665378181500616168026"); let b = BigInt("-1335261903387109315496127911856753636351038338604616204371912816438406948185324050250724")
        print(a ** 14, " ", a.pow(14), " ", pow(a, 14, m), " ", a.pow(14, m), " ")
        println(a.gcd(b), " ", a.lcm(b), " ", a.abs.isqrt(), " ", a * b == b * a)
    } while false
    do { let a = BigInt("0"); let m = BigInt("-437356493272477843193638577537228777061500708181414474064916"); let b = BigInt("1081911591604609086437554270413099089898263793")
        print(a ** 25, " ", a.pow(25), " ", pow(a, 25, m), " ", a.pow(25, m), " ")
        println(a.gcd(b), " ", a.lcm(b), " ", a.abs.isqrt(), " ", a * b == b * a)
    } while false
    do { let a = BigInt("63"); let m = BigInt("119"); let b = BigInt("-10317174315994095755")
        print(a ** 0, " ", a.pow(0), " ", pow(a, 0, m), " ", a.pow(0, m), " ")
        println(a.gcd(b), " ", a.lcm(b), " ", a.abs.isqrt(), " ", a * b == b * a)
    } while false
    do { let a = BigInt("261854768760368969045516963540622160276"); let m = BigInt("101"); let b = BigInt("4976838816470850702")
        print(a ** 24, " ", a.pow(24), " ", pow(a, 24, m), " ", a.pow(24, m), " ")
        println(a.gcd(b), " ", a.lcm(b), " ", a.abs.isqrt(), " ", a * b == b * a)
    } while false
    do { let a = BigInt("-6679986240828747759534040917976315080"); let m = BigInt("10"); let b = BigInt("-4764380010436419618")
        print(a ** 38, " ", a.pow(38), " ", pow(a, 38, m), " ", a.pow(38, m), " ")
        println(a.gcd(b), " ", a.lcm(b), " ", a.abs.isqrt(), " ", a * b == b * a)
    } while false
    do { let a = BigInt("-131406828133380291419481094515833859105"); let m = BigInt("-11091729157673477901"); let b = BigInt("372189795859156340867304088613658947210166428290502758992134066239766181818710900887097255")
        print(a ** 13, " ", a.pow(13), " ", pow(a, 13, m), " ", a.pow(13, m), " ")
        println(a.gcd(b), " ", a.lcm(b), " ", a.abs.isqrt(), " ", a * b == b * a)
    } while false
    do { let a = BigInt("4212929460293236015"); let m = BigInt("13639972463760760124"); let b = BigInt("-17526912985532827443")
        print(a ** 15, " ", a.pow(15), " ", pow(a, 15, m), " ", a.pow(15, m), " ")
        println(a.gcd(b), " ", a.lcm(b), " ", a.abs.isqrt(), " ", a * b == b * a)
    } while false
    do { let a = BigInt("-1448029049409583081"); let m = BigInt("131"); let b = BigInt("-12997196950752553275")
        print(a ** 6, " ", a.pow(6), " ", pow(a, 6, m), " ", a.pow(6, m), " ")
        println(a.gcd(b), " ", a.lcm(b), " ", a.abs.isqrt(), " ", a * b == b * a)
    } while false
    do { let a = BigInt("35137801989612579872"); let m = BigInt("13288173465382317102"); let b = BigInt("8841522653215338171")
        print(a ** 33, " ", a.pow(33), " ", pow(a, 33, m), " ", a.pow(33, m), " ")
        println(a.gcd(b), " ", a.lcm(b), " ", a.abs.isqrt(), " ", a * b == b * a)
    } while false
    println(pow(BigInt("252513622686564290240454093"), -3, BigInt("-127898261939861007580007948503")))
    println(pow(BigInt("456534176190147169794062271"), -5, BigInt("-272996917253627598731020461221")))
    println(pow(BigInt("907292567846051426676121204"), -19, BigInt("-1120160111322300692027877746473")))
    println(pow(BigInt("442528976956706684574369534"), -2, BigInt("46734762877893412925707979633")))
    println(pow(BigInt("-394784641724174186764692085"), -3, BigInt("-129631893219478438077355081159")))
    println(pow(BigInt("912470924548175826143886520"), -5, BigInt("439406944460288164195798904313")))
    println((BigInt("-") * BigInt("")) % 1000000007n, " ", (BigInt("-") * BigInt("")).text(16).count)
    println((BigInt("") * BigInt("")) % 1000000007n, " ", (BigInt("") * BigInt("")).text(16).count)
    return 0
}
